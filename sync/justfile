LOG_LEVEL := "debug"

tests: default-tests wisckey-tests

default-tests:
    env RUST_BACKTRACE=1 RUST_LOG={{LOG_LEVEL}} cargo nextest run

lint:
    cargo clippy --no-default-features -- -D warnings

check-formatting:
    cargo fmt --check

fix-formatting:
    cargo fmt

udeps:
    cargo udeps --all-targets --release

wisckey-tests:
    env RUST_BACKTRACE=1 RUST_LOG={{LOG_LEVEL}} cargo nextest run --no-default-features --features=snappy-compression,wisckey
